# Copiar para .env.local (desenvolvimento) e definir as mesmas variáveis no Vercel.

# Código da conta GoatCounter (https://<site>.goatcounter.com)
GOATCOUNTER_SITE=andersonneto

# Token da API: GoatCounter → Settings → API → "Read statistics"
GOATCOUNTER_TOKEN=

# Password de acesso ao painel
DASHBOARD_PASSWORD=

# Segredo longo e aleatório para assinar a sessão (ex.: openssl rand -hex 32)
SESSION_SECRET=
